
#include <stdio.h>
#define MAX 5

int queue[MAX];
int front = -1, rear = -1;

void insert() {
    int x;

    if(rear == MAX - 1) {
        printf("Queue Overflow\n");
    } else {
        printf("Enter element: ");
        scanf("%d", &x);

        if(front == -1)
            front = 0;

        queue[++rear] = x;
    }
}

void delete() {
    if(front == -1 || front > rear) {
        printf("Queue Underflow\n");
    } else {
        printf("Deleted: %d\n", queue[front++]);

        if(front > rear)
            front = rear = -1;
    }
}

void display() {
    int i;

    if(front == -1) {
        printf("Queue is Empty\n");
    } else {
        for(i = front; i <= rear; i++)
            printf("%d ", queue[i]);
    }
}

int main() {
    int ch;

    do {
        printf("\n1.INSERT 2.DELETE 3.DISPLAY 4.EXIT");
        printf("\nEnter choice: ");
        scanf("%d", &ch);

        switch(ch) {
            case 1: insert(); break;
            case 2: delete(); break;
            case 3: display(); break;
            case 4: break;
            default: printf("Invalid Choice");
        }
    } while(ch != 4);

    return 0;
}
